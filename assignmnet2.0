      "source": [
        "# save as app.py\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import re\n",
        "import nltk\n",
        "from nltk.corpus import stopwords\n",
        "from nltk.stem import WordNetLemmatizer\n",
        "from nltk import pos_tag\n",
        "from nltk.sentiment.vader import SentimentIntensityAnalyzer\n",
        "from wordcloud import WordCloud\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.decomposition import LatentDirichletAllocation\n",
        "from sklearn.cluster import KMeans\n",
        "from collections import Counter\n",
        "\n",
        "# -------------------------\n",
        "# Streamlit page config\n",
        "# -------------------------\n",
        "st.set_page_config(page_title=\"Netflix NLP Dashboard\", layout=\"wide\")\n",
        "st.title(\"📺 Netflix NLP Dashboard\")\n",
        "\n",
        "# -------------------------\n",
        "# NLTK downloads\n",
        "# -------------------------\n",
        "nltk.download('wordnet')\n",
        "nltk.download('omw-1.4')\n",
        "nltk.download('stopwords')\n",
        "nltk.download('punkt')\n",
        "nltk.download('averaged_perceptron_tagger')\n",
        "nltk.download('vader_lexicon')\n",
        "\n",
        "# -------------------------\n",
        "# File uploader\n",
        "# -------------------------\n",
        "uploaded_file = st.file_uploader(\"Upload your Netflix CSV file\", type=[\"csv\"])\n",
        "if uploaded_file is not None:\n",
        "    df = pd.read_csv(uploaded_file)\n",
        "    st.success(f\"✅ Dataset loaded: {df.shape}\")\n",
        "    st.dataframe(df.head())\n",
        "\n",
        "    # -------------------------\n",
        "    # Combine title + description\n",
        "    # -------------------------\n",
        "    df['text'] = df['title'].fillna('') + \" \" + df['description'].fillna('')\n",
        "\n",
        "    # -------------------------\n",
        "    # Clean text\n",
        "    # -------------------------\n",
        "    def clean_text(text):\n",
        "        text = str(text).lower()\n",
        "        text = re.sub(r\"http\\S+|www.\\S+\", \" \", text)\n",
        "        text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
        "        text = re.sub(r\"\\s+\", \" \", text).strip()\n",
        "        return text\n",
        "\n",
        "    df['clean_text'] = df['text'].apply(clean_text)\n",
        "\n",
        "    # -------------------------\n",
        "    # Tokenize + POS-aware Lemmatization\n",
        "    # -------------------------\n",
        "    stop_words = set(stopwords.words('english'))\n",
        "    lemmatizer = WordNetLemmatizer()\n",
        "\n",
        "    def preprocess(text):\n",
        "        tokens = text.split()\n",
        "        tokens = [t for t in tokens if t not in stop_words]\n",
        "        pos_tags = pos_tag(tokens)\n",
        "        tokens = [lemmatizer.lemmatize(word, pos='v' if tag.startswith('V') else 'n') for word, tag in pos_tags]\n",
        "        return tokens\n",
        "\n",
        "    df['tokens'] = df['clean_text'].apply(preprocess)\n",
        "\n",
        "    # -------------------------\n",
        "    # Sentiment Analysis\n",
        "    # -------------------------\n",
        "    sid = SentimentIntensityAnalyzer()\n",
        "    df['vader_score'] = df['clean_text'].apply(lambda x: sid.polarity_scores(x)['compound'])\n",
        "    df['sentiment'] = df['vader_score'].apply(\n",
        "        lambda x: 'Positive' if x > 0.05 else ('Negative' if x < -0.05 else 'Neutral')\n",
        "    )\n",
        "\n",
        "    st.subheader(\"🎭 Sentiment Counts\")\n",
        "    st.bar_chart(df['sentiment'].value_counts())\n",
        "\n",
        "    # -------------------------\n",
        "    # WordCloud function\n",
        "    # -------------------------\n",
        "    def plot_wordcloud(text, title, colormap='viridis'):\n",
        "        wordcloud = WordCloud(width=800, height=400, background_color='white', colormap=colormap).generate(text)\n",
        "        plt.figure(figsize=(10,5))\n",
        "        plt.imshow(wordcloud, interpolation='bilinear')\n",
        "        plt.axis('off')\n",
        "        plt.title(title)\n",
        "        st.pyplot(plt)\n",
        "        plt.close()\n",
        "\n",
        "    # -------------------------\n",
        "    # Barplot function for top words\n",
        "    # -------------------------\n",
        "    def plot_top_words(tokens_list, title, palette):\n",
        "        words = [word for tokens in tokens_list for word in tokens]\n",
        "        freq = Counter(words).most_common(20)\n",
        "        if len(freq) == 0:\n",
        "            st.write(f\"No words to display for {title}\")\n",
        "            return\n",
        "        words, counts = zip(*freq)\n",
        "        plt.figure(figsize=(10,5))\n",
        "        sns.barplot(x=counts, y=words, palette=palette)\n",
        "        plt.title(title)\n",
        "        st.pyplot(plt)\n",
        "        plt.close()\n",
        "\n",
        "    # -------------------------\n",
        "    # Sentiment WordClouds & Top Words\n",
        "    # -------------------------\n",
        "    for sentiment, color in zip(['Positive', 'Negative', 'Neutral'], ['Greens', 'Reds', 'Blues']):\n",
        "        st.subheader(f\"WordCloud - {sentiment} Sentiment\")\n",
        "        text = \" \".join(df[df['sentiment'] == sentiment]['clean_text'])\n",
        "        plot_wordcloud(text, f\"WordCloud of {sentiment} Netflix Titles & Descriptions\", colormap=color)\n",
        "\n",
        "        st.subheader(f\"Top Words - {sentiment} Sentiment\")\n",
        "        plot_top_words(df[df['sentiment'] == sentiment]['tokens'], f\"Top 20 Words in {sentiment} Descriptions\", palette=color)\n",
        "\n",
        "    # -------------------------\n",
        "    # TF-IDF + LDA Topic Modeling\n",
        "    # -------------------------\n",
        "    tfidf = TfidfVectorizer(max_features=1000, stop_words='english', ngram_range=(1,2))\n",
        "    X_tfidf = tfidf.fit_transform(df['clean_text'])\n",
        "\n",
        "    lda = LatentDirichletAllocation(n_components=5, random_state=42)\n",
        "    lda.fit(X_tfidf)\n",
        "    feature_names = tfidf.get_feature_names_out()\n",
        "\n",
        "    st.subheader(\"🧩 LDA Topic Modeling (Top 10 words per topic)\")\n",
        "    for i, topic in enumerate(lda.components_):\n",
        "        st.write(f\"**Topic {i+1}:**\", [feature_names[j] for j in topic.argsort()[-10:]])\n",
        "\n",
        "    # -------------------------\n",
        "    # KMeans Clustering\n",
        "    # -------------------------\n",
        "    kmeans = KMeans(n_clusters=5, random_state=42)\n",
        "    df['cluster'] = kmeans.fit_predict(X_tfidf)\n",
        "    st.subheader(\"🎯 Cluster Counts\")\n",
        "    st.bar_chart(df['cluster'].value_counts())\n",
        "\n",
        "    # -------------------------\n",
        "    # Save processed CSV\n",
        "    # -------------------------\n",
        "    df.to_csv(\"netflix_nlp_streamlit.csv\", index=False)\n",
        "    st.success(\"✅ Enhanced NLP processing complete! Results saved to netflix_nlp_streamlit.csv\")\n"
      ]
    },
    {
